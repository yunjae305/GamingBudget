<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 12 이상용 백업·기기 이전 규칙. files/mirror.json 이 새 폰으로 따라가게 한다.
     live/ 는 화면 파일이라 뺀다 — 새 APK 의 원본이 옛 화면에 덮이면 안 된다. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="file" path="live" />
        <include domain="sharedpref" path="." />
        <!-- 결제 알림 원문(감지 기록·대기열)은 폰 밖으로 내보내지 않는다 -->
        <exclude domain="sharedpref" path="pay_pending.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="file" path="live" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="pay_pending.xml" />
    </device-transfer>
</data-extraction-rules>
